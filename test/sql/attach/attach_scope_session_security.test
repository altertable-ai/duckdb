# name: test/sql/attach/attach_scope_session_security.test
# description: Session attach security and read-only binding enforcement
# group: [attach]

require skip_reload

statement ok
PRAGMA enable_verification

statement ok
ATTACH '__TEST_DIR__/scope_session_sec_rw.db' AS sec_rw (READ_WRITE, SCOPE SESSION)

statement ok
CREATE TABLE sec_rw.t AS SELECT 1 AS i

statement ok con2
ATTACH '__TEST_DIR__/scope_session_sec_rw.db' AS sec_ro (READ_ONLY, SCOPE SESSION)

query I con2
SELECT i FROM sec_ro.t
----
1

statement error con2
INSERT INTO sec_ro.t VALUES (2)
----
read-only mode

# Plain DETACH cannot remove another connection's session binding
statement error
DETACH sec_ro
----
database not found

# Plain DETACH removes the caller's own session binding (session-first)
statement ok con2
DETACH sec_ro

statement error con2
SELECT * FROM sec_ro.t
----
Catalog Error

query I
SELECT i FROM sec_rw.t
----
1
